// Datasource and generator
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum CoverflexStatus {
  RECEIPT
  WAITING
  PAID
}

// ---------- Auth.js (NextAuth v5) Prisma adapter models ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  accounts        Account[]
  sessions        Session[]
  expenses        Expense[]
  tasksCreated    Task[] @relation("TaskCreator")
  tasksAssigned   Task[] @relation("TaskAssignee")
  shoppingItems   ShoppingItem[]
  incomeEntries   IncomeEntry[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Domain models ----------

model Category {
  id            String   @id @default(cuid())
  name          String
  parentId      String?
  parent        Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children      Category[] @relation("CategoryTree")
  // Monthly spending objective. Only meaningful on top-level categories
  // (subcategory expenses roll into the parent for budget purposes).
  monthlyBudget Decimal?
  // Hex color (e.g. "#1192e8") shown for this category across every Home
  // dashboard chart. Only meaningful on top-level categories. Null falls
  // back to the curated default palette.
  color         String?
  // When false, expenses under this category (or, for a subcategory,
  // expenses tagged with it) are excluded from every Home dashboard chart
  // and total, without affecting the Expenses page.
  visible       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  expensesAsCategory    Expense[] @relation("ExpenseCategory")
  expensesAsSubcategory Expense[] @relation("ExpenseSubcategory")

  @@unique([name, parentId])
}

model Reimburser {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Expense {
  id            String   @id @default(cuid())
  value         Decimal
  description   String
  comment       String?
  date          DateTime
  isJoint       Boolean  @default(false)
  coverflexStatus CoverflexStatus @default(RECEIPT)

  // Reimbursement: expected refund (can be partial of value), source
  // (e.g. employer / insurance), and confirmation timestamp once received.
  reimbursementAmount Decimal?
  reimburser          String?
  reimbursedAt        DateTime?

  categoryId    String
  category      Category @relation("ExpenseCategory", fields: [categoryId], references: [id])

  subcategoryId String?
  subcategory   Category? @relation("ExpenseSubcategory", fields: [subcategoryId], references: [id])

  userId        String
  user          User     @relation(fields: [userId], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([date])
  @@index([userId])
  @@index([categoryId])
  @@index([reimbursedAt])
}

// Admin-managed list of income rubrics (e.g. "Vencimento Empresa 1", "Baixa",
// "Ajudas de custo", "Km", "Subsídio de alimentação", "Outro"), shared by
// both household members — mirrors Category/Reimburser. `irsPct`/`ssPct`
// are the default tax rates applied when a line of this type is added;
// each line can still override them. `requiresNote` forces a description
// on every line of this type (used for "Outro", but not hardcoded to it).
model IncomeSourceType {
  id           String   @id @default(cuid())
  name         String   @unique
  irsPct       Decimal  @default(0)
  ssPct        Decimal  @default(0)
  requiresNote Boolean  @default(false)
  visible      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lines        IncomeLine[]
}

// One month's income for one user. Made up of one or more IncomeLines (one
// per rubric); the month's total is the sum of each line's net amount.
model IncomeEntry {
  id        String   @id @default(cuid())
  month     DateTime // always normalized to the 1st of the month

  userId    String
  user      User     @relation(fields: [userId], references: [id])

  lines     IncomeLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, month])
  @@index([month])
}

// A single rubric within a month's income (e.g. this month's "Vencimento
// Empresa 1"). `irsPct`/`ssPct` are snapshotted from the source type when
// the line is added, but editable per line since rates can change.
// Net amount = grossAmount * (1 - irsPct - ssPct).
model IncomeLine {
  id             String   @id @default(cuid())
  grossAmount    Decimal
  irsPct         Decimal
  ssPct          Decimal
  note           String?

  incomeEntryId  String
  incomeEntry    IncomeEntry      @relation(fields: [incomeEntryId], references: [id], onDelete: Cascade)

  sourceTypeId   String
  sourceType     IncomeSourceType @relation(fields: [sourceTypeId], references: [id])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([incomeEntryId])
  @@index([sourceTypeId])
}

model Task {
  id          String    @id @default(cuid())
  description String
  priority    String    @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  recurrence  String?   // null | DAILY | WEEKLY | MONTHLY
  deadline    DateTime?
  completed   Boolean   @default(false)
  completedAt DateTime?

  userId      String
  user        User      @relation("TaskCreator", fields: [userId], references: [id])

  assigneeId  String?
  assignee    User?     @relation("TaskAssignee", fields: [assigneeId], references: [id])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([deadline])
  @@index([completed])
  @@index([userId])
  @@index([assigneeId])
}

model ShoppingItem {
  id          String    @id @default(cuid())
  name        String
  quantity    String?
  recurrence  String?   // null | DAILY | WEEKLY | MONTHLY
  dueDate     DateTime?
  bought      Boolean   @default(false)
  boughtAt    DateTime?

  userId      String
  user        User      @relation(fields: [userId], references: [id])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([bought])
  @@index([dueDate])
  @@index([userId])
}

// Single-row app-wide settings, editable in Admin. Only one row is ever
// used (id "singleton") — see lib/dashboard-settings.ts.
model DashboardSetting {
  id                       String   @id @default(cuid())
  // Estimated "healthy" Expenses/Income ratio, stored as a fraction (0.5 =
  // 50%). Used to color the ratio shown in the "Income vs expenses"
  // dashboard tooltip: red above this, green at or below it.
  expensesIncomePct        Decimal  @default(0.5)
  updatedAt                DateTime @updatedAt
}
